# .dockerignore - files to exclude from Docker build context

# Git
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Ultron specific
logs/
uploads/
data/
*.db
*.sqlite
*.log

# Test files
test_*.py
*_test.py

# Documentation
*.md
!README.md

# Environment (use env_file in compose instead)
.env
.env.local
.env.*.local