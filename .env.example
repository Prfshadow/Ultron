# Ultron AI Assistant - environment variables (API keys)
# Copy this file to `.env` and fill in the keys you want to use.
# Keys are read from this file only - they cannot be changed from the web UI.
# Ultron automatically falls back to the next provider if one fails.

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CYFUTURE_API_KEY=your_cyfuture_api_key_here

# Optional tuning
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1
